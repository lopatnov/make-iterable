{
  "name": "@lopatnov/make-iterable",
  "version": "3.0.0",
  "description": "How to make object as array? This TypeScript library makes objects as Array like and iterable.",
  "author": "lopatnov",
  "license": "Apache-2.0",
  "homepage": "https://lopatnov.github.io/make-iterable/",
  "umdName": "makeIterable",
  "source": "src/make-iterable.ts",
  "main": "dist/make-iterable.cjs",
  "module": "dist/make-iterable.esm.mjs",
  "browser": "dist/make-iterable.umd.js",
  "types": "dist/make-iterable.d.ts",
  "exports": {
    ".": {
      "import": "./dist/make-iterable.esm.mjs",
      "require": "./dist/make-iterable.cjs",
      "browser": "./dist/make-iterable.umd.js",
      "types": "./dist/make-iterable.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopatnov/make-iterable.git"
  },
  "bugs": {
    "url": "https://github.com/lopatnov/make-iterable/issues"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -cw",
    "test": "node --import tsx --test tests/make-iterable.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "configure-npm": "node ./set-registry.js -s https://registry.npmjs.org",
    "configure-gpr": "node ./set-registry.js -s https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "TypeScript",
    "JavaScript",
    "Iterable",
    "Iterator",
    "Array",
    "ArrayLike",
    "typescript-library"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lopatnov/rollup-plugin-uglify": "^4.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "rollup": "^4.0.0",
    "tslib": "^2.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
